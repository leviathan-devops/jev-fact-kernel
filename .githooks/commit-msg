#!/usr/bin/env bash
# commit-msg — the BYPASSABLE twin of prepare-commit-msg.
#
# Same two checks (semantic prefix + W-8 claim-evidence), on $1.
# Kept because this is the conventional location and it fires for
# `git merge`. Unlike prepare-commit-msg, this hook CAN be bypassed
# with --no-verify; prepare-commit-msg is the absolute anchor.
#
# FIXED (W1 audit): aligned claim list with prepare-commit-msg, added
# merge/squash exemptions, word-bounded claim words, narrowed evidence.
set -uo pipefail

MSG_FILE="${1:?usage: commit-msg <msg-file>}"
SOURCE="${2:-message}"

# A merge/squash message is GENERATED, not authored — exempt like
# prepare-commit-msg.
if [ "$SOURCE" = "merge" ] || [ "$SOURCE" = "squash" ]; then
  exit 0
fi

MSG="$(grep -v '^#' "$MSG_FILE" 2>/dev/null || true)"

if [ -z "$(printf '%s' "$MSG" | tr -d '[:space:]')" ]; then
  exit 0
fi

# CHECK 1 — the semantic prefix.
# FIXED 2026-09-23 (ocr hooks-final HIGH): grep -qE tests EACH line, and `^`
# anchors to any line start — so a BODY line beginning "feat: " satisfied the
# check even when the SUBJECT lacked a prefix (a FALSE PASS). Anchor to the
# first non-empty line (the subject) ONLY.
FIRST_LINE="$(printf '%s\n' "$MSG" | grep -v '^[[:space:]]*$' | head -n1)"
if ! printf '%s' "$FIRST_LINE" | grep -qE '^(feat|fix|docs|test|build|refactor|blueprint|goal|chore|spec|perf)(\([^)]+\))?: '; then
  echo 'REJECT(W-8): message lacks semantic prefix ^(feat|fix|docs|test|build|refactor|blueprint|goal|chore|spec|perf)(scope)?: ' >&2
  exit 1
fi

# CHECK 2 — the claim-evidence rule (W-8).
# FIXED: aligned claim list with prepare-commit-msg, word-bounded claims,
# narrowed evidence (path-like prefix required for file:line).
if printf '%s' "$MSG" | grep -qiE '\b(verified|passed|tested|works|green|done|complete|completed|finished|shipped|landed|delivered)\b'; then
  HAS_EVIDENCE=0
  printf '%s' "$MSG" | grep -qE '[0-9]+ (pass|tests)' && HAS_EVIDENCE=1
  printf '%s' "$MSG" | grep -qE '\b[0-9a-f]*[a-f][0-9a-f]{6,39}\b' && HAS_EVIDENCE=1
  printf '%s' "$MSG" | grep -qE '\b[a-zA-Z0-9_/.-]+\.(ts|md|sh|yml|json|py|js):[0-9]+\b' && HAS_EVIDENCE=1
  printf '%s' "$MSG" | grep -qE '\b[a-zA-Z0-9_/.-]+/[^ ]+:[0-9]+\b' && HAS_EVIDENCE=1
  printf '%s' "$MSG" | grep -qE '\b[a-zA-Z][a-zA-Z0-9_-]{1,}:[0-9]+\b' && HAS_EVIDENCE=1
  if [ "$HAS_EVIDENCE" -eq 0 ]; then
    echo 'REJECT(W-8): claim word (verified|passed|tested|works|green|done|complete|completed|finished|shipped|landed|delivered) with no artifact; include a test count ("N pass"/"N tests"), a sha ([a-f0-9]{7,40}), or a file:line (path.ext:NN)' >&2
    exit 1
  fi
fi

exit 0
