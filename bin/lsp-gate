#!/usr/bin/env bash
# ── bin/lsp-gate ──────────────────────────────────────────────────────────────────────────────
# THE REGISTRATION GATE — the carrier that can SEE its subject.
#
# WHY THIS EXISTS (the measured reason, not a theory):
#   omp's plugin hook union carries 18 events. NONE is an LSP event:
#     agent_start/end · before_agent_start · before/after_provider_request · message_start/end/update
#     session_start/stop/shutdown/switch/branch/compact/tree · tool_call · tool_result · ttsr_triggered
#   `lsp_registration` appears NOWHERE in the runtime — a plugin binding it is a NO-OP.
#   THE CARRIER LAW: a check runs on the carrier that can see its subject. Nothing in the plugin
#   API sees an LSP registration. But omp's lsp.json carries a `command` it SPAWNS — and that
#   command IS the registration. So the gate lives THERE.
#
#   omp already wraps server commands natively (lsp/lspmux.d.ts:35 LspmuxWrappedCommand =
#   {command, args, env}, "Wrap a server command to use lspmux client mode"). This is that
#   pattern, carrying a probe instead of a mux.
#
# USAGE (in lsp.json, in place of the server's command):
#   "command": ["/abs/path/bin/lsp-gate", "bun", "scripts/plutus-lsp.ts", "--stdio"]
#
# CONTRACT:
#   BLOCK  → the ledger row is written, the message prints, exit is NON-ZERO, and `exec` is
#            NEVER reached: THE SERVER NEVER RUNS, so it never completes `initialize`, so it
#            NEVER REGISTERS. Enforcement-by-absence.
#   PASS   → `exec "$@"` — this process BECOMES the server. Zero overhead, zero indirection.
#   UNREAD → exit 2. An unread path is NEVER a pass. (FR-13, the fail-closed law.)
set -uo pipefail

KERNEL="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${LSP_GATE_ROOT:-$PWD}"
PROBE="$KERNEL/kernel/tier4-lsp-capability-probe.py"

if [ "$#" -eq 0 ]; then
  echo "FACT-FIREWALL T4: no command given — nothing to gate." >&2
  exit 2
fi

if [ ! -f "$PROBE" ]; then
  echo "FACT-FIREWALL T4: the probe is ABSENT at $PROBE. An unread path is not a pass." >&2
  exit 2
fi

# NO DOWNGRADE BY ENVIRONMENT (the gate-audit CRITICAL). This gate previously honoured
# `FACT_FIREWALL_LSP=warn`, which flip the posture to ledger-and-register. THE DEFECT: the env is
# INHERITED BY THE SERVER BEING GATED — so a lying server, or anything that owns its launch
# environment, could set `warn` and neuter its own gate. A fail-closed gate is not downgrade-able
# by a variable its own subject controls.
#
# THE REPAIR IS NOT A VARIABLE. To run a server through this gate while it is under repair, edit
# the `command` in lsp.json — an action only the operator's own hand performs, on a file the
# server does not write. fail-closed is the posture; the alternative is a documented edit.
OUT="$(python3 "$PROBE" "$ROOT" "$@" 2>&1)"
RC=$?

if [ "$RC" -eq 2 ] || printf '%s' "$OUT" | grep -q 'UNREAD'; then
  printf '%s\n' "$OUT" >&2
  echo "FACT-FIREWALL T4: the probe could not READ the server. Refusing to register UNVERIFIED." >&2
  exit 2
fi
if [ "$RC" -ne 0 ] || printf '%s' "$OUT" | grep -q 'T4 BLOCK'; then
  # stdout is the LSP protocol channel — the probe's text goes to STDERR so a captured stdout
  # can never be parsed as JSON-RPC by the client. (`bin/lsp-gate:63` finding.)
  printf '%s\n' "$OUT" >&2
  # THE CLAIM, CORRECTED (the gate-audit's sharpest finding). This once read "the server was NEVER
  # EXECUTED" — FALSE, and my own probe disproves it: `tier4-lsp-capability-probe.py:110` does a
  # `subprocess.Popen(cmd, …)` and speaks LSP `initialize` to the server to interrogate it. THE
  # SERVER RUNS ONCE, under the probe, before any verdict. What the gate withholds is the LIVE
  # REGISTRATION: no long-lived client session, no editor wiring, no capability advertisement to a
  # consumer. A hostile server is not prevented from running — it is prevented from being ADOPTED.
  echo "FACT-FIREWALL T4: registration REFUSED — the server gets no live registration (it ran once" >&2
  echo "  under the probe; what it never gets is the client session and the capability surface)." >&2
  exit 1
fi
exec "$@"
